# Replace these values with long, unique secrets before starting the app.
DB_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
STAFF_INVITE_CODE=replace-with-a-unique-invite-code-at-least-16-characters
WEB_PORT=8080
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
# For public hosting: set HOST_DOMAIN to your domain, use WEB_PORT=127.0.0.1:8080,
# SESSION_COOKIE_SECURE=true, and CORS_ALLOWED_ORIGINS=https://your-domain.example
HOST_DOMAIN=hostel.example.com
